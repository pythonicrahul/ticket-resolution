# Copy to .env and fill in your own values. .env is git-ignored. Never commit a real key.

# Model provider: OpenRouter (default) or Groq. Both are OpenAI-compatible.
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq alternative: LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
JUDGE_MODEL_NAME=replace_with_a_different_free_model
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.0          # set from the dev sweep (FR-10)

# Classification and routing
TRAINING_TICKETS_PATH=./data/development_tickets.json
CONFIDENCE_THRESHOLD=0.80        # placeholder; set from the dev sweep (FR-02)

# Decision log and cache
DATABASE_URL=sqlite:///./storage/decisions.db
LLM_CACHE_PATH=./storage/llm_cache.sqlite

# Kill switch (FR-16): if this file exists, nothing is auto-sent
KILL_SWITCH_FILE=./storage/KILL_SWITCH

LOG_LEVEL=INFO
