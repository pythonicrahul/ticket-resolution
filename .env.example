# Copy to .env and fill in your own values. .env is git-ignored. Never commit a real key.

# Model provider. Both are OpenAI-compatible; the system does not care which, and every id
# below was checked against the provider's live catalogue rather than remembered.
#
# **Groq is the one that works** (D-47). OpenRouter's `:free` endpoints route through a pool
# shared by every free user: measured 2026-09-28, 20 consecutive attempts over four minutes were
# all rejected with `limit_source: upstream_provider_shared_pool` while the account's own quota
# sat untouched, and buying credits would not have changed it. Groq's free tier gives per-account
# limits instead: 1000 requests/day per model and 8000 tokens/minute.
LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter alternative: LLM_BASE_URL=https://openrouter.ai/api/v1 — and then every model id
# below needs its `vendor/model:free` form, which is OpenRouter syntax and does not exist on Groq.
#
# MODEL_NAME has no default in code: a missing value refuses to start rather than pick a model.
# NFR-07 allows no spend, so the id must be one the free tier serves. Confirm against the live
# catalogue, which is account-specific:
#   curl -sH "Authorization: Bearer $LLM_API_KEY" https://api.groq.com/openai/v1/models | jq -r '.data[].id'
#
#   MODEL_NAME       openai/gpt-oss-120b — 131k context, and it returned a valid AnswerDraft with
#                    a correct citation on the first attempt, with no repair (D-47). gpt-oss-20b
#                    also passes every check and is the fallback if 120b is throttled; both share
#                    the same 8000 tokens/minute budget, so the larger one is not more expensive.
#   JUDGE_MODEL_NAME qwen/qwen3.8-27b — a different vendor on purpose. FR-12's grounding check is
#                    not independent if the judge is the model being judged.
MODEL_NAME=openai/gpt-oss-120b
JUDGE_MODEL_NAME=qwen/qwen3.8-27b
# 8000 tokens/minute is the binding limit, not the 1000/day: a drafting call with five passages is
# roughly 1300 tokens, so about six calls a minute. A gate run over 80 validation tickets (~100
# calls at T=0.85) therefore takes 15-20 minutes and must pace itself rather than burst — row 14's
# wiring has to allow for that, or the harness will escalate good tickets as provider_unavailable.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
# Circuit breaker (FR-15): how many consecutive failures open it, and for how long. These are
# what keep an induced outage (A11) to seconds instead of hours. A malformed value fails loudly.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.25        # chosen at checkpoint row 7 from the dev sweep (D-38)

# Classification and routing
TRAINING_TICKETS_PATH=./data/development_tickets.json
# Trained by scripts/train_classifier.py; the harness loads it and never trains during a run.
CLASSIFIER_PATH=./storage/classifier.joblib
# Chosen by the author at checkpoint row 10 from evaluation/reports/confidence_sweep.md (D-44).
# 0.85 is the lowest value at which no must-escalate ticket is auto-answered on wording the
# classifier has not seen. It costs answer rate (64% of tickets answered) and it breaches NFR-06's
# 5-point fairness limit (10.1-point fluent/non-fluent gap), which the PRD revision declares.
CONFIDENCE_THRESHOLD=0.85

# Decision log (FR-13) and the response cache (FR-15, NFR-07)
DECISION_LOG_PATH=./storage/decisions.db
LLM_CACHE_PATH=./storage/llm_cache.sqlite

# Kill switch (FR-16): if this file exists, nothing is auto-sent
KILL_SWITCH_FILE=./storage/KILL_SWITCH

LOG_LEVEL=INFO
