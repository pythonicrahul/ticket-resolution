# Copy to .env and fill in your own values. .env is git-ignored. Never commit a real key.

# Model provider. Every one of these is OpenAI-compatible, and the system has never known which
# host it talks to: switching provider has never required a code change (D-47, D-55).
#
# **OpenAI, on a small paid budget** (D-55). The author moved here after two gate runs were
# spoiled by free-tier throttling: OpenRouter's free endpoints refused 20 consecutive attempts
# from a shared pool (D-46); Groq's free tier escalated 21 of 80 tickets without trying them, and
# 8 of 65 even after the system learned to pace itself and to treat a throttle as pacing rather
# than as an outage (D-54). NFR-07 therefore became a *budget* rather than a prohibition — the
# spend is reported in the metrics, and the free-tier path is still here below.
LLM_BASE_URL=https://api.openai.com/v1

# The only secret. Left empty on purpose: `.env.example` carries placeholders only (CLAUDE.md),
# and this file is committed. A missing key used to let a run finish with all 80 tickets
# escalated as `provider_unavailable` and exit 0, which reads as a result — the harness refuses
# to start without it now, the way it already refuses without a classifier (R9 review).
LLM_API_KEY=
#
# MODEL_NAME has no default in code: a missing value refuses to start rather than pick a model.
# Model ids change and are account-specific, so confirm against your own catalogue:
#   curl -sH "Authorization: Bearer $LLM_API_KEY" https://api.openai.com/v1/models | jq -r '.data[].id' | sort
#
#   MODEL_NAME       a small, cheap, instruction-following model. `gpt-4o-mini` is the safe
#                    default; swap in whatever mini-class model your account lists. What matters
#                    is that it returns JSON reliably, because FR-11 parses every reply into
#                    `schemas.AnswerDraft` and a reply that will not parse is an escalation.
#   JUDGE_MODEL_NAME a **different** model on purpose: FR-12's grounding check is not independent
#                    if the judge is the model being judged. A different size from the same
#                    vendor is weaker than a different vendor, and is what a single key allows.
MODEL_NAME=gpt-4o-mini
JUDGE_MODEL_NAME=gpt-4.1-mini
#
#   Cost: a measured 80-ticket run made 155 provider calls and cost about **$0.03** (D-68),
#   averaging about 800 tokens a call. An answered ticket costs two calls and one escalated by
#   rule costs one; the README has the table. The response cache means a re-run over the same
#   tickets costs nothing, and `--limit N` bounds any experiment.
#
# Free-tier alternatives, kept because they still work and cost nothing:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#               MODEL_NAME=openai/gpt-oss-120b   JUDGE_MODEL_NAME=qwen/qwen3.8-27b
#               1000 requests/day per model, 8000 tokens/minute, which a full run exceeds.
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1, and every id needs its `:free` suffix.
#               Measured unusable in 2026 (D-46); listed for completeness.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
# Circuit breaker (FR-15): how many consecutive failures open it, and for how long. These are
# what keep an induced outage (A11) to seconds instead of hours. A malformed value fails loudly.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.25        # chosen at checkpoint row 7 from the dev sweep (D-38)

# Classification and routing
TRAINING_TICKETS_PATH=./data/development_tickets.json
# Trained by scripts/train_classifier.py; the harness loads it and never trains during a run.
CLASSIFIER_PATH=./storage/classifier.joblib
# Set to 0.70 by the author to answer more tickets. The trade-off is measured on grouped
# out-of-fold predictions in evaluation/reports/confidence_sweep.md:
#
#   T     answered      must-escalate answered   tickets T alone decided
#   0.70  415 (83.0%)   10                       0
#   0.80  393 (78.6%)    9                      22
#   0.85  322 (64.4%)    0                      93   <- D-44's choice at checkpoint row 10
#
# **At 0.70 the floor never fires.** No development ticket states an out-of-fold confidence below
# 0.75, so every row from T=0.00 to T=0.75 is identical. The `confidence_floor` guardrail still
# runs on every reply (FR-12) and simply never blocks. FR-09's rule still escalates a *predicted*
# security_incident, compliance_request, feature_request or unclear_request; the 10 above are the
# ones the classifier misreads, which T was the second line of defence against (FR-09 spec §7).
CONFIDENCE_THRESHOLD=0.70

# Decision log (FR-13) and the response cache (FR-15, NFR-07)
DECISION_LOG_PATH=./storage/decisions.db
LLM_CACHE_PATH=./storage/llm_cache.sqlite

# Kill switch (FR-16): if this file exists, nothing is auto-sent
KILL_SWITCH_FILE=./storage/KILL_SWITCH

LOG_LEVEL=INFO
