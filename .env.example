# Copy to .env and fill in your own values. .env is git-ignored. Never commit a real key.

# Model provider: OpenRouter (default) or Groq. Both are OpenAI-compatible.
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq alternative: LLM_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME has no default in code: a missing value refuses to start rather than pick a model.
# On OpenRouter the free endpoints carry the ":free" suffix — without it you are on the paid
# endpoint, which NFR-07 forbids. Confirm the exact id against the provider's current catalogue:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'
# The free roster turns over: every id this file previously suggested (llama-3.1-8b-instruct,
# llama-3.3-70b, deepseek-r1, qwen-2.5-72b) has since left it. Checked 2026-09-28, 21 zero-cost
# models, of which these two were chosen:
#
#   MODEL_NAME       google/gemma-4-31b-it:free — dense instruction-tuned, 262k context, and it
#                    advertises structured outputs, which is what FR-11's drafting needs
#                    (ProviderClient.complete_structured parses into schemas.AnswerDraft).
#   JUDGE_MODEL_NAME qwen/qwen3.8-27b:free — a different vendor and family on purpose. FR-12's
#                    grounding check is not independent if the judge is the model being judged.
#
# Avoid `openrouter/free` (a router alias: it picks a model for you, so the same input can reach
# different models and NFR-08's determinism is gone) and anything named preview, alpha or stealth.
MODEL_NAME=google/gemma-4-31b-it:free
JUDGE_MODEL_NAME=qwen/qwen3.8-27b:free
# Free-tier rate limits (OpenRouter, checked 2026-09-28): 20 requests/minute and **50 requests/day**,
# rising to 1000/day for an account that has bought $10 of credits at any point. A gate run over 80
# validation tickets needs roughly 100 calls at T=0.85 (a draft plus a grounding check per answered
# ticket), so 50/day will not complete one. The response cache makes re-runs nearly free, but the
# first full run needs either the higher tier or a batched run across days.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
# Circuit breaker (FR-15): how many consecutive failures open it, and for how long. These are
# what keep an induced outage (A11) to seconds instead of hours. A malformed value fails loudly.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.25        # chosen at checkpoint row 7 from the dev sweep (D-38)

# Classification and routing
TRAINING_TICKETS_PATH=./data/development_tickets.json
# Trained by scripts/train_classifier.py; the harness loads it and never trains during a run.
CLASSIFIER_PATH=./storage/classifier.joblib
# Chosen by the author at checkpoint row 10 from evaluation/reports/confidence_sweep.md (D-44).
# 0.85 is the lowest value at which no must-escalate ticket is auto-answered on wording the
# classifier has not seen. It costs answer rate (64% of tickets answered) and it breaches NFR-06's
# 5-point fairness limit (10.1-point fluent/non-fluent gap), which the PRD revision declares.
CONFIDENCE_THRESHOLD=0.85

# Decision log (FR-13) and the response cache (FR-15, NFR-07)
DECISION_LOG_PATH=./storage/decisions.db
LLM_CACHE_PATH=./storage/llm_cache.sqlite

# Kill switch (FR-16): if this file exists, nothing is auto-sent
KILL_SWITCH_FILE=./storage/KILL_SWITCH

LOG_LEVEL=INFO
